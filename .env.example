# Hub uses an embedded database under .dev/paseo-hub by default. Set DATABASE_URL to use PostgreSQL.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/paseo_hub
# PASEO_HUB_DATA_DIR=.dev/paseo-hub
PASEO_HUB_APP_URL=http://localhost:3000
# Optional advanced override. Hub otherwise generates and stores a stable secret in its database.
# PASEO_HUB_AUTH_SECRET=
# Admission and organization provisioning policy. These defaults keep a new instance closed
# until its owner is bootstrapped and members are invited.
PASEO_REGISTRATION_MODE=invite_only
PASEO_ORGANIZATION_CREATION=disabled
# Set all three bootstrap values together for a fresh or migrated instance.
PASEO_BOOTSTRAP_ORGANIZATION=
PASEO_BOOTSTRAP_OWNER_EMAIL=
PASEO_BOOTSTRAP_OWNER_PASSWORD=
# GitHub connection and webhook authority. The private key may instead use
# GITHUB_APP_PRIVATE_KEY_PATH.
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Discord connection and authenticated gateway authority.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Optional advanced Slack authority. Leave this group commented to set up Slack in the browser.
# Socket Mode requires all three values; workspace bot tokens are then connected in the browser.
# SLACK_TRANSPORT=socket
# SLACK_APP_ID=A0123456789
# SLACK_APP_TOKEN=xapp-your-app-level-token
# Webhooks require all five values below and a public HTTPS address.
# SLACK_TRANSPORT=webhook
# SLACK_APP_ID=A0123456789
# SLACK_CLIENT_ID=123456789.123456789
# SLACK_CLIENT_SECRET=your-client-secret
# SLACK_SIGNING_SECRET=your-signing-secret
# Optional billing integration. Leave these unset to expose no billing routes, navigation, or UI.
# Both are required together: setting STRIPE_SECRET_KEY
# without STRIPE_WEBHOOK_SECRET fails startup, since the webhook signature could not be verified.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
